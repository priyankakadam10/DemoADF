{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFlearning-Demo-2026"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://learningdataeng.dfs.core.windows.net/"
		},
		"Daily_Trigger_properties_pl_file_transfer_parameters_filePattern": {
			"type": "string",
			"defaultValue": "*.csv"
		},
		"Daily_Trigger_properties_pl_file_transfer_parameters_fileExtension": {
			"type": "string",
			"defaultValue": ".csv"
		},
		"Daily_Trigger_properties_pl_file_transfer_parameters_feedName": {
			"type": "string",
			"defaultValue": "orders"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFlearning-Demo-2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"Daily_Trigger_properties_pl_file_transfer_parameters_filePattern": {
						"value": "[parameters('Daily_Trigger_properties_pl_file_transfer_parameters_filePattern')]"
					},
					"Daily_Trigger_properties_pl_file_transfer_parameters_fileExtension": {
						"value": "[parameters('Daily_Trigger_properties_pl_file_transfer_parameters_fileExtension')]"
					},
					"Daily_Trigger_properties_pl_file_transfer_parameters_feedName": {
						"value": "[parameters('Daily_Trigger_properties_pl_file_transfer_parameters_feedName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}